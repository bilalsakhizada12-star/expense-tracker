# Server
PORT=3000

# PostgreSQL connection string.
# Leave unset to run in zero-setup demo mode (in-memory database, data is not saved).
# Example for a local database:
# DATABASE_URL=postgres://expense:expense@localhost:5432/expense_tracker
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
